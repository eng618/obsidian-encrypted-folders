{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["DOM", "ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "allowJs": true,
    "importHelpers": true,
    "isolatedModules": true,
    "inlineSourceMap": true,
    "inlineSources": true,
    "useDefineForClassFields": false,
    "types": ["vitest/globals"]
  },
  "include": ["**/*.ts"]
}
