{
  "name": "obsidian-encrypted-folders",
  "version": "1.7.2",
  "private": true,
  "description": "Obsidian plugin to encrypt folders within your vault.",
  "keywords": [
    "encryption",
    "folders",
    "obsidian",
    "obsidian-plugin"
  ],
  "license": "MIT",
  "author": "Eric N. Garcia <eng618@garciaericn.com>",
  "type": "commonjs",
  "main": "dist/main.js",
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "format": "oxfmt --write .",
    "format:ci": "oxfmt --check .",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix",
    "prepare": "husky",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit --skipLibCheck",
    "validate": "./scripts/validate.sh",
    "version": "node scripts/version-bump.mjs && git add manifest.json versions.json"
  },
  "devDependencies": {
    "@gv-tech/oxc-config": "^1.3.0",
    "@types/node": "^26.5.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "fast-check": "^4.9.0",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.6.0",
    "nano-staged": "^1.0.2",
    "obsidian": "^1.13.1",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "tslib": "2.8.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vite-plugin-static-copy": "^4.1.1",
    "vitest": "^4.1.11"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs,mts,cts}": [
      "oxfmt --write",
      "oxlint --fix"
    ],
    "*.{json,jsonc,md,yml,yaml}": [
      "oxfmt --write"
    ]
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "bun@1.3.9"
}
