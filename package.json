{
  "name": "obsidian-encrypted-folders",
  "version": "1.7.3",
  "private": true,
  "description": "Obsidian plugin to encrypt folders within your vault.",
  "keywords": [
    "encryption",
    "folders",
    "obsidian",
    "obsidian-plugin"
  ],
  "license": "MIT",
  "author": "Eric N. Garcia <eng618@garciaericn.com>",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "format": "oxfmt --write .",
    "format:ci": "oxfmt --check .",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix",
    "prepare": "husky",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit --skipLibCheck",
    "validate": "./scripts/validate.sh",
    "version": "node scripts/version-bump.mjs && git add manifest.json versions.json"
  },
  "devDependencies": {
    "@gv-tech/oxc-config": "^1.3.0",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.0.5",
    "fast-check": "^4.10.2",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "lint-staged": "^17.6.0",
    "obsidian": "^1.14.4",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "tslib": "^2.9.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs,mts,cts}": [
      "oxfmt --write --no-error-on-unmatched-pattern",
      "oxlint --fix"
    ],
    "*.{json,jsonc,md,yml,yaml}": [
      "oxfmt --write --no-error-on-unmatched-pattern"
    ]
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "bun@1.4.4"
}
